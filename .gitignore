# Батники: локальные не пушим, точки входа и routing/ — пушим.
# 🪤 Здесь allowlist, а не blocklist: новый .bat в корне по умолчанию НЕ едет в репо.
# Так и потерялся SHARE.bat (в README описан, в git его нет вообще), а HUB.bat едва
# не уехал тем же путём — а на него показывают ВСЕ форвардеры, то есть на свежем
# клоне под Windows не запускалось бы ничего. Добавил файл в корень — добавь строку.
#
# UPDATE.bat / DOCTOR.bat / SHARE.bat / FIX.bat сняты 24.08 при уборке корня (было
# 30 файлов): обновление, диагностика и «поделиться» стали пунктами меню хаба.
*.bat
!routing/*.bat
!HUB.bat
!START.bat

# Routing dir runtime artefacts
# Пул прокси: конфиг с кредами, привязки «аккаунт → адрес» и разовые seed-файлы для
# дочернего open-session.js. Ни одно из этого не коммитится: в конфиге логин/пароль
# прокси, привязки — состояние конкретной машины, seed живёт один запуск.
routing/proxy-pool.json
routing/proxy-assign.json
routing/runtime/
# Липкий UA на аккаунт: выбор конкретной машины, не код
agentrouter/ua/

routing/*.log
routing/*.err
routing/*.log.err
routing/*.log.out
routing/mode.txt
routing/keepalive-config-*.json
# Архив настроек предыдущей версии дефолтов (пишется при смене CFG_VERSION)
routing/keepalive-config-*.json.v*.bak
# Суточная история времени ответа (минутные бакеты, у каждого своя)
routing/keepalive-latency-*.json
# Пул-дроп: маркер «карта опущена на фолбэк» и бэкапы карт на возврат. Это состояние
# КОНКРЕТНОЙ машины в конкретный день, а не код: в git ему делать нечего, а `add -A`
# утащил бы его в коммит и устроил конфликты на каждом дропе.
routing/*-pooldrop.json
routing/*-modelmap.pooldrop.bak.json
# История событий прокси: те же минутные бакеты, что латентность — данные, не конфиг
routing/keepalive-events-*.json
routing/keepalive-events-*.json.tmp
